        "com.fasterxml.jackson.core:jackson-annotations:2.20",
        "dev.openjavaformat:open-java-format:2.98.0.6",
        "tools.jackson.core:jackson-databind:3.2.3",
        "io.opentelemetry:opentelemetry-api:1.67.0",
        "io.opentelemetry:opentelemetry-sdk:1.67.0",
        "io.github.classgraph:classgraph:6.0.0",
        "io.netty:netty-codec-http:4.2.19.Final",
        "org.mongodb:mongodb-driver-sync:5.13.0",
