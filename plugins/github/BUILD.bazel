load("@rules_jvm_external//:defs.bzl", "artifact")
load("//bazel/noel:plugin.bzl", "noel_plugin")

package(
    default_visibility = ["//visibility:public"],
)

noel_plugin(
    name = "github",
    srcs = ["src/dev/floofy/noel/github/GitHubPlugin.java"],
    deps = [
        "//plugins/discord",
        "//plugins/github/api",
        "//plugins/http-client",
        "//plugins/pinecone",
        artifact("com.google.inject:guice"),
        artifact("org.slf4j:slf4j-api"),
        artifact("net.dv8tion:JDA"),
    ],
)
